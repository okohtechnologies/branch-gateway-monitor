# Copy to .env and fill in. .env is gitignored: never commit real values.

# --- Required ----------------------------------------------------------------------
# Used by docker-compose for the bundled PostgreSQL. Use LETTERS AND DIGITS ONLY: it is placed
# inside a connection URL, so characters like @ / : # % break it ("Name or service not known").
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Signs login sessions. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# From @BotFather. Message your bot once, then see README "Find your chat ID".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Only when running WITHOUT docker-compose (python -m ipmon) -------------------------
# DATABASE_URL=postgresql://ipmon:password@localhost:5432/ipmon

# --- Optional ----------------------------------------------------------------------------
# TZ=Africa/Lagos           # IANA time zone for alert and /mute times (default UTC)
# Dead-man's-switch ping URL (healthchecks.io). Treat it as a secret.
# HEARTBEAT_URL=https://hc-ping.com/your-uuid

# The values below are only DEFAULTS. Most can be changed later in the dashboard (Settings), and a
# change made there takes priority until you reset it.
# PROBE_INTERVAL_S=30
# PROBE_COUNT=4
# PROBE_TIMEOUT_S=2
# CANARY_ENABLED=true
# DEFAULT_LATENCY_WARN_MS=200   # pre-filled when adding a branch
# DEFAULT_LOSS_WARN_PCT=20
# CONFIRM=3                  # consecutive results needed to confirm a status change
# REMINDER_MINUTES=30        # 0 disables reminders
# RETENTION_DAYS=30          # raw checks older than this are deleted; 0 keeps everything
# BACKUP_KEEP_DAYS=14        # how many daily database backups docker-compose keeps
# CANARY_HOST=1.1.1.1
# CANARY_PORT=443
# CANARY_TYPE=tcp            # tcp or icmp
# BOT_ENABLED=true
# COOKIE_SECURE=false        # set true if you serve the dashboard over HTTPS
